# Medora runtime environment -> copy to /opt/apps/medora/.env on the server (chmod 600).
# Shared by the backend and frontend containers (docker compose env_file).
# PORT / HOST / HOSTNAME / NODE_ENV / NODE_OPTIONS are set by docker-compose.yml; don't set them here.

# ---------- Backend (required) ----------
# Postgres on the shared container (external Docker network apps-net). Database + user: medora.
DATABASE_URL=postgresql://medora:CHANGE_ME_DB_PASSWORD@shared-postgres:5432/medora
# JWT signing secret for the session cookie, >= 32 chars. Generate: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_48
# Comma-separated browser origins (no spaces). Used for CORS AND the CSRF origin check on every
# write request / sign-in, so it MUST contain the public frontend URL exactly.
CORS_ORIGINS=https://medora.13.203.3.1.sslip.io
# Public frontend URL.
APP_URL=https://medora.13.203.3.1.sslip.io
# Trust X-Forwarded-For from Nginx and the Next.js /api proxy so login throttling sees real client IPs.
TRUST_PROXY=loopback,linklocal,uniquelocal

# ---------- Backend (optional, defaults shown) ----------
# Hours an offline POS sale may be queued before sync rejects it.
POS_OFFLINE_MAX_HOURS=24
# Days before expiry that a batch counts as "near expiry".
NEAR_EXPIRY_DAYS=90
# Redis: barcode lookup cache (API falls back to Postgres without it) and the BullMQ maintenance
# worker (compose profile "worker"). Not provisioned on this host. Example: redis://some-redis:6379
REDIS_URL=

# ---------- Seed (only for the one-time initial seed) ----------
# Password for the five seeded accounts (owner@medora.local, pharmacist@, cashier@, store_keeper@, auditor@),
# 12+ chars. Generate: openssl rand -base64 18. The seed also inserts DEMO catalogue/stock data.
SEED_PASSWORD=

# ---------- Frontend ----------
# Build-time only (baked into the image by the deploy workflow; listed for reference, changing it here has no effect):
#   API_URL=http://medora-backend:4004   # /api/* rewrite target on the internal Docker network (/api prefix is stripped)
