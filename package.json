{
  "name": "pharmacy-management",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "check": "npm run check -w backend && npm run check -w frontend",
    "test": "npm run test -w backend",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "setup": "node scripts/setup.mjs",
    "services": "docker compose up -d --wait"
  },
  "devDependencies": {"concurrently": "^9.2.1", "@playwright/test": "^1.58.2", "typescript": "^5.9.3"},
  "engines": {"node": ">=22.12"}
}
