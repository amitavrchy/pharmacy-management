{
  "name": "@pharmacy/backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node ../scripts/dev-backend.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/jobs/worker.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^5.70.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "prisma": "^7.10.1",
    "tsx": "^4.21.0"
  }
}
