{
  "name": "@pharmacy/backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node init && node scripts/dev-backend.mjs",
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node dist/src/main.js",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/jobs/worker.ts",
    "dev:all": "node init && concurrently -n api,web \"npm run dev\" \"npm --prefix ../frontend run dev\"",
    "setup": "node scripts/setup.mjs",
    "services": "docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --wait",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^5.70.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
