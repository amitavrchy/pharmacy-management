generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  PHARMACIST
  CASHIER
  STORE_KEEPER
  AUDITOR
}

model Shop {
  id                     String         @id @default(cuid())
  name                   String
  drugLicenseNo          String?
  address                String         @default("")
  phone                  String         @default("")
  timezone               String         @default("Asia/Dhaka")
  currency               String         @default("BDT")
  requirePharmacistForRx Boolean        @default(true)
  saleWithoutBatchScan   Boolean        @default(true)
  minMarginBps           Int            @default(500)
  returnDays             Int            @default(7)
  users                  User[]
  medicines              Medicine[]
  suppliers              Supplier[]
  batches                StockBatch[]
  prescriptions          Prescription[]
  sales                  Sale[]
  alerts                 Alert[]
  audit                  AuditEntry[]
}

model User {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id])
  name         String
  email        String   @unique
  role         Role
  passwordHash String
  pinHash      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Generic {
  id               String     @id @default(cuid())
  name             String     @unique
  therapeuticClass String?
  medicines        Medicine[]
}

model Medicine {
  id           String              @id @default(cuid())
  shopId       String
  shop         Shop                @relation(fields: [shopId], references: [id])
  genericId    String
  generic      Generic             @relation(fields: [genericId], references: [id])
  brandName    String
  manufacturer String
  strength     String
  form         String
  packSize     Int                 @default(1)
  barcode      String?             @unique
  schedule     String              @default("OTC")
  unitName     String              @default("pcs")
  priceMinor   Int
  reorderLevel Decimal             @default(50) @db.Decimal(14, 3)
  active       Boolean             @default(true)
  batches      StockBatch[]
  saleLines    SaleLine[]
  rxItems      PrescriptionItem[]
  poLines      PurchaseOrderLine[]

  @@index([shopId, genericId])
}

model StockBatch {
  id           String             @id @default(cuid())
  shopId       String
  shop         Shop               @relation(fields: [shopId], references: [id])
  medicineId   String
  medicine     Medicine           @relation(fields: [medicineId], references: [id])
  lotNumber    String
  expiryDate   DateTime           @db.Date
  qtyOnHand    Decimal            @db.Decimal(14, 3)
  costMinor    Int
  rack         String             @default("")
  status       String             @default("ACTIVE")
  recalled     Boolean            @default(false)
  locationId   String?
  location     StockLocation?     @relation(fields: [locationId], references: [id])
  allocations  SaleLineBatch[]
  movements    StockMovement[]
  receiptLines GoodsReceiptLine[]

  @@unique([shopId, medicineId, lotNumber, expiryDate, locationId])
  @@index([shopId, medicineId, expiryDate])
}

model Supplier {
  id      String          @id @default(cuid())
  shopId  String
  shop    Shop            @relation(fields: [shopId], references: [id])
  name    String
  phone   String?
  email   String?
  address String?
  orders  PurchaseOrder[]
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  shopId     String
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     String              @default("DRAFT")
  notes      String              @default("")
  createdAt  DateTime            @default(now())
  lines      PurchaseOrderLine[]
  receipts   GoodsReceiptLine[]

  @@index([shopId, createdAt])
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id])
  medicineId  String
  medicine    Medicine      @relation(fields: [medicineId], references: [id])
  qty         Decimal       @db.Decimal(14, 3)
  receivedQty Decimal       @default(0) @db.Decimal(14, 3)
  costMinor   Int
}

model GoodsReceiptLine {
  id         String        @id @default(cuid())
  poId       String
  po         PurchaseOrder @relation(fields: [poId], references: [id])
  medicineId String
  lotNumber  String
  expiryDate DateTime      @db.Date
  qty        Decimal       @db.Decimal(14, 3)
  costMinor  Int
  batchId    String
  batch      StockBatch    @relation(fields: [batchId], references: [id])
  createdAt  DateTime      @default(now())
}

model Prescription {
  id           String             @id @default(cuid())
  shopId       String
  shop         Shop               @relation(fields: [shopId], references: [id])
  rxNumber     String
  doctorName   String
  patientName  String
  patientPhone String?
  imageData    String?
  status       String             @default("CAPTURED")
  verifiedBy   String?
  capturedAt   DateTime           @default(now())
  items        PrescriptionItem[]
  sales        Sale[]

  @@index([shopId, capturedAt])
}

model PrescriptionItem {
  id                String       @id @default(cuid())
  prescriptionId    String
  prescription      Prescription @relation(fields: [prescriptionId], references: [id])
  medicineId        String
  medicine          Medicine     @relation(fields: [medicineId], references: [id])
  qtyPrescribed     Decimal      @db.Decimal(14, 3)
  qtyDispensed      Decimal      @default(0) @db.Decimal(14, 3)
  dispenseAsWritten Boolean      @default(false)
  saleLines         SaleLine[]
}

model Sale {
  id                  String         @id @default(cuid())
  shopId              String
  shop                Shop           @relation(fields: [shopId], references: [id])
  cashierId           String
  customerId          String?
  customer            Customer?      @relation(fields: [customerId], references: [id])
  shiftId             String?
  shift               RegisterShift? @relation(fields: [shiftId], references: [id])
  clientSaleId        String         @unique
  prescriptionId      String?
  prescription        Prescription?  @relation(fields: [prescriptionId], references: [id])
  customerName        String?
  customerPhone       String?
  status              String         @default("COMPLETED")
  totalMinor          Int
  subtotalMinor       Int
  discountMinor       Int            @default(0)
  tenders             Json
  substitutionConsent Boolean        @default(false)
  witness             String?
  completedAt         DateTime       @default(now())
  lines               SaleLine[]
  returns             SaleReturn[]

  @@index([shopId, completedAt])
}

model SaleLine {
  id                 String            @id @default(cuid())
  saleId             String
  sale               Sale              @relation(fields: [saleId], references: [id])
  medicineId         String
  medicine           Medicine          @relation(fields: [medicineId], references: [id])
  qty                Decimal           @db.Decimal(14, 3)
  unitPriceMinor     Int
  prescriptionItemId String?
  prescriptionItem   PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id])
  batches            SaleLineBatch[]
}

model SaleLineBatch {
  id          String     @id @default(cuid())
  saleLineId  String
  saleLine    SaleLine   @relation(fields: [saleLineId], references: [id])
  batchId     String
  batch       StockBatch @relation(fields: [batchId], references: [id])
  qty         Decimal    @db.Decimal(14, 3)
  returnedQty Decimal    @default(0) @db.Decimal(14, 3)
  costMinor   Int
}

model SaleReturn {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  status      String   @default("REQUESTED")
  reason      String
  requestedBy String
  approvedBy  String?
  refundMinor Int      @default(0)
  createdAt   DateTime @default(now())
}

model StockMovement {
  id        String     @id @default(cuid())
  batchId   String
  batch     StockBatch @relation(fields: [batchId], references: [id])
  type      String
  qty       Decimal    @db.Decimal(14, 3)
  refType   String?
  refId     String?
  note      String?
  createdAt DateTime   @default(now())
}

model Alert {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id])
  type       String
  key        String    @unique
  payload    Json
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AuditEntry {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  actorId   String
  action    String
  entityId  String
  details   Json
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}

model SyncReview {
  id           String   @id @default(cuid())
  shopId       String
  clientSaleId String   @unique
  actorId      String
  payload      Json
  reason       String
  status       String   @default("PENDING_REVIEW")
  createdAt    DateTime @default(now())
}

model Customer {
  id               String           @id @default(cuid())
  shopId           String
  name             String
  phone            String?
  email            String?
  address          String           @default("")
  allergies        String[]         @default([])
  conditions       String[]         @default([])
  contactConsent   Boolean          @default(false)
  creditLimitMinor Int              @default(0)
  balanceMinor     Int              @default(0)
  loyaltyPoints    Int              @default(0)
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  sales            Sale[]
  ledger           CustomerLedger[]

  @@unique([shopId, phone])
  @@index([shopId, name])
}

model CustomerLedger {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  kind        String
  amountMinor Int
  method      String?
  reference   String   @unique
  note        String
  actorId     String
  createdAt   DateTime @default(now())
}

model RegisterShift {
  id            String         @id @default(cuid())
  shopId        String
  cashierId     String
  registerName  String
  status        String         @default("OPEN")
  openingMinor  Int
  countedMinor  Int?
  expectedMinor Int?
  varianceMinor Int?
  closingNote   String?
  openedAt      DateTime       @default(now())
  closedAt      DateTime?
  movements     CashMovement[]
  sales         Sale[]

  @@index([shopId, status])
}

model CashMovement {
  id          String        @id @default(cuid())
  shiftId     String
  shift       RegisterShift @relation(fields: [shiftId], references: [id])
  kind        String
  amountMinor Int
  reference   String        @unique
  note        String
  actorId     String
  createdAt   DateTime      @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  shopId      String
  category    String
  amountMinor Int
  method      String
  note        String
  reference   String   @unique
  actorId     String
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
}

model SupplierBill {
  id            String            @id @default(cuid())
  shopId        String
  supplierId    String
  poId          String?
  invoiceNumber String
  totalMinor    Int
  paidMinor     Int               @default(0)
  dueDate       DateTime          @db.Date
  status        String            @default("UNPAID")
  note          String            @default("")
  createdAt     DateTime          @default(now())
  payments      SupplierPayment[]

  @@unique([shopId, supplierId, invoiceNumber])
}

model SupplierPayment {
  id          String       @id @default(cuid())
  billId      String
  bill        SupplierBill @relation(fields: [billId], references: [id])
  amountMinor Int
  method      String
  reference   String       @unique
  actorId     String
  note        String
  createdAt   DateTime     @default(now())
}

model StockLocation {
  id          String              @id @default(cuid())
  shopId      String
  name        String
  code        String
  kind        String              @default("COUNTER")
  canDispense Boolean             @default(true)
  quarantined Boolean             @default(false)
  active      Boolean             @default(true)
  batches     StockBatch[]
  sensors     TemperatureSensor[]

  @@unique([shopId, code])
}

model StockTransfer {
  id              String    @id @default(cuid())
  shopId          String
  batchId         String
  destinationId   String
  qty             Decimal   @db.Decimal(14, 3)
  status          String    @default("DRAFT")
  note            String
  createdBy       String
  createdAt       DateTime  @default(now())
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  receivedBatchId String?

  @@index([shopId, status])
}

model TemperatureSensor {
  id         String               @id @default(cuid())
  shopId     String
  locationId String
  location   StockLocation        @relation(fields: [locationId], references: [id])
  name       String
  minC       Decimal              @db.Decimal(6, 2)
  maxC       Decimal              @db.Decimal(6, 2)
  latestC    Decimal?             @db.Decimal(6, 2)
  excursion  Boolean              @default(false)
  readings   TemperatureReading[]
}

model TemperatureReading {
  id        String            @id @default(cuid())
  sensorId  String
  sensor    TemperatureSensor @relation(fields: [sensorId], references: [id])
  valueC    Decimal           @db.Decimal(6, 2)
  excursion Boolean
  note      String
  actorId   String
  createdAt DateTime          @default(now())
}

model Delivery {
  id        String   @id @default(cuid())
  shopId    String
  saleId    String   @unique
  recipient String
  phone     String
  address   String
  courier   String?
  status    String   @default("QUEUED")
  note      String   @default("")
  proof     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefillReminder {
  id             String   @id @default(cuid())
  shopId         String
  customerId     String
  prescriptionId String?
  dueDate        DateTime @db.Date
  status         String   @default("SCHEDULED")
  note           String
  createdBy      String
  createdAt      DateTime @default(now())

  @@index([shopId, dueDate])
}
